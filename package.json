{
  "name": "codex-build-android-apps",
  "version": "0.2.2",
  "private": true,
  "description": "Android development, emulator mirroring and annotations for Codex on macOS and Windows",
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25"
  },
  "bin": {
    "build-android-apps": "server/dist/cli.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "check": "npm run build && npm test && npm run test:ui",
    "doctor": "node server/dist/cli.mjs doctor",
    "pack:plugin": "node scripts/package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "fast-xml-parser": "5.11.2",
    "ws": "8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "esbuild": "^0.28.2"
  }
}
